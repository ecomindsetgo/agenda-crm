rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /_consultorioAutomation/{document=**} {
      allow read, write: if false;
    }
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    match /artifacts/psicologia-agenda-default-v2/users/{userId}/appointments/{id} {
      allow read, create, update: if owner(userId);
      // Borrado excepcional: debe carecer de pagos, historia financiera y actividad clínica.
      allow delete: if owner(userId)
        && (!('paidAmount' in resource.data) || resource.data.paidAmount == 0)
        && (!('paymentHistory' in resource.data) || resource.data.paymentHistory.size() == 0)
        && (!('paymentStatus' in resource.data) || !(resource.data.paymentStatus in ['pagado', 'parcial']))
        && (!('packageId' in resource.data) || resource.data.packageId == null || resource.data.packageId == '')
        && (!('packageConsumed' in resource.data) || resource.data.packageConsumed == false)
        && (!('status' in resource.data) || !(resource.data.status in ['completada', 'in_session', 'arrived']))
        && (!('notes' in resource.data) || resource.data.notes == '');
    }
    match /artifacts/psicologia-agenda-default-v2/users/{userId}/appointmentDeletionAudit/{id} {
      allow read: if owner(userId);
      allow create: if owner(userId)
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.appointmentId is string
        && request.resource.data.appointmentId.size() > 0
        && request.resource.data.deletedAt is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 8;
      allow update, delete: if false;
    }
    match /artifacts/psicologia-agenda-default-v2/users/{userId}/patients/{id} {
      allow read, write: if owner(userId);
    }
    match /artifacts/psicologia-agenda-default-v2/users/{userId}/clinicalHistories/{id} {
      allow read, write: if owner(userId);
    }
    match /artifacts/psicologia-agenda-default-v2/users/{userId}/clinicalNotes/{id} {
      allow read, write: if owner(userId);
    }
  }
}
